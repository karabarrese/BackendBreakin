# .env.example - Copy this file and rename your copy to .env

SUPABASE_URL= your_supabase_api_endpoint_here
#paste in everything before the ?apikey= in your Supabase URL. It should start with https://... 
#ex: https://insert_endpoint_here.supabase.co/rest/v1/sales

SUPABASE_API_KEY=your_supabase_secret_key_here
#paste in everything after ?apikey= in your Supabase URL (before &'s if there are any). It should start with sb_...
